#!/bin/sh /etc/rc.common
# mu300-volte-in -- 监听 VoLTE 来电，让多个 SIP 分机同时振铃
START=96
STOP=10
USE_PROCD=1

# 同时振铃的分机（逗号分隔）。只写一个就退回"单分机直连"模式，行为与本项目
# 上游的单分机版本一致。dialplan [volte-in] 里的 Dial(a&b) 要与此保持一致。
RING_EXTS=${MU300_IN_EXTS:-6001,6002}

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/python3 /usr/bin/mu300-volte-in.py
	procd_set_param env MU300_IN_EXTS="$RING_EXTS"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
